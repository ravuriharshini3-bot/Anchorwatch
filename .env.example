# --- Supabase (from Supabase project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL (your Vercel domain, e.g. https://anchorwatch.vercel.app) ---
NEXT_PUBLIC_SITE_URL=

# --- Resend (from resend.com dashboard, for sending alert emails) ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# --- Stripe (from Stripe Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Cron security (any random long string you make up yourself) ---
CRON_SECRET=
